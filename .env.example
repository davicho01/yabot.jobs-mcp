# Base URL of the running Yabot Jobs FastAPI backend.
YABOT_API_BASE_URL=http://localhost:8000

# Base URL of the running Yabot Jobs frontend — the OAuth consent screen
# (/oauth/authorize) lives there.
YABOT_FRONTEND_BASE_URL=http://localhost:3000

# This server's own publicly reachable URL (its OAuth issuer identity).
# http://localhost:8080 only works for local testing.
YABOT_MCP_PUBLIC_URL=http://localhost:8080
